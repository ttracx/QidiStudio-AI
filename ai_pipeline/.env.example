# THOX printer-agent configuration. Copy to .env; never commit .env.
# Every value is read from the environment. No credential is ever written to a
# log, an event record, or an HTTP response.

# --------------------------------------------------------------------------
# Printer  (REQUIRED - there is deliberately no default)
# --------------------------------------------------------------------------
# An unset host raises a clear error rather than silently addressing whatever
# machine happens to answer at a baked-in address.
THOX_PRINTER_HOST=
THOX_PRINTER_PORT=7125
THOX_MOONRAKER_API_KEY=

# --------------------------------------------------------------------------
# Autonomy - what the agent may do without a human
# --------------------------------------------------------------------------
#   observe    = alerts only, never acts
#   suggest    = raises a suggestion and waits for a human   (default)
#   auto_pause = may pause on its own above the confidence threshold
# The agent can NEVER cancel or reprint at any level. That is not configurable.
THOX_AUTONOMY=suggest
THOX_AUTO_PAUSE_CONFIDENCE=0.85
THOX_ALERT_SEVERITY=0.5
# Consecutive flagged samples required before anything happens. 1 causes false
# pauses from a passing toolhead or one bad exposure.
THOX_CONFIRM_FRAMES=3
# Minimum gap between autonomous actions, so a flapping detector cannot loop.
THOX_ACTION_COOLDOWN_S=300

# --------------------------------------------------------------------------
# Sampling cadence
# --------------------------------------------------------------------------
THOX_SAMPLE_INTERVAL_S=45
THOX_ALERT_INTERVAL_S=12
THOX_FIRST_LAYER_INTERVAL_S=20
THOX_FIRST_LAYER_COUNT=3

# --------------------------------------------------------------------------
# Vision ensemble - providers run in PARALLEL
# --------------------------------------------------------------------------
# cv_motion needs no credentials and is the always-on tripwire; the language
# models classify what it flags. With cv_motion alone you have change detection
# and an exposure gate, NOT defect classification, and the UI says so.
THOX_PROVIDERS=cv_motion,ollama_local
THOX_PROVIDER_TIMEOUT_S=240

# Local Ollama. No frame leaves the LAN.
THOX_OLLAMA_BASE_URL=
THOX_OLLAMA_MODEL=huihui_ai/qwen3-vl-abliterated:latest
# Must clear a thinking model's reasoning phase AND its answer. Measured: an
# empty string at 400 and 1200 tokens, correct JSON at 3000+, and reasoning
# length varies run to run. Lowering this silently breaks the provider.
THOX_OLLAMA_NUM_PREDICT=6000

# Ollama Cloud - frames LEAVE the LAN. Off until a key is set.
THOX_OLLAMA_CLOUD_API_KEY=
THOX_OLLAMA_CLOUD_MODEL=kimi-k2.5:cloud

# OpenAI - frames LEAVE the LAN. Off until a key is set.
# NOTE: the placeholder value "ollama" is treated as UNSET, so the provider
# reports itself unavailable instead of failing on every call.
THOX_OPENAI_API_KEY=
THOX_OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------------
# Safety envelope for scan motion
# --------------------------------------------------------------------------
THOX_MAX_SCAN_HOTEND_C=60
THOX_Z_MIN_SAFE_MM=5
THOX_Z_MAX_SAFE_MM=250
THOX_Z_CLEARANCE_MM=15

# --------------------------------------------------------------------------
# Scan reconstruction
# --------------------------------------------------------------------------
THOX_STATIONS=12
# 1 = shape preview only (NOT dimensionally reliable).
# 4 = you rotate the object between passes; ~+/-2 mm.
THOX_AZIMUTHS=1
THOX_VOXEL_MM=0.8
THOX_MAX_VOXELS=12000000

# Stop after this many revised reprints and ask a human.
THOX_MAX_REPRINT_ATTEMPTS=2
