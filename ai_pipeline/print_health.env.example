# THOX / QidiStudio-AI Print Health
# Copy the values you need into your shell environment or a local .env file.
# Never commit real keys.

# Qidi Q2 on the printer LAN
THOX_QIDI_HOST=10.1.10.153
THOX_MOONRAKER_PORT=7125
THOX_MOONRAKER_API_KEY=
# Optional if Moonraker webcam discovery does not expose the Qidi snapshot path:
THOX_QIDI_CAMERA_SNAPSHOT_URL=
THOX_QIDI_UI_URL=http://10.1.10.153

# Default autonomy: detect + high-confidence auto-pause only.
THOX_PRINT_HEALTH_MODE=autopause
THOX_AUTO_PAUSE_CONFIDENCE=0.78
THOX_MIN_VISION_PROVIDERS=2
THOX_CRITICAL_CONFIRM_FRAMES=2
THOX_MAX_REPRINTS=2

# Explicit destructive autonomy gates. Keep false until the system is validated
# against your printer/profile/material matrix.
THOX_ALLOW_AGENT_CANCEL=false
THOX_ALLOW_AGENT_RESTART=false
THOX_ALLOW_AGENT_REPRINT=false

# Adaptive sampling intervals
THOX_HEALTHY_SAMPLE_S=15
THOX_SUSPECT_SAMPLE_S=5
THOX_WARNING_SAMPLE_S=2.5
THOX_CRITICAL_SAMPLE_S=1
THOX_WARNING_THRESHOLD=0.45
THOX_CRITICAL_THRESHOLD=0.76
THOX_VISION_TIMEOUT_S=45

# OpenAI vision. gpt-5 is the conservative documented default; override with a
# newer image-capable Responses API model available to your project if desired.
OPENAI_API_KEY=
THOX_OPENAI_VISION_MODEL=gpt-5
THOX_OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local vision on the Mac
THOX_OLLAMA_LOCAL_URL=http://127.0.0.1:11434
THOX_OLLAMA_LOCAL_MODEL=qwen3-vl:4b

# Direct Ollama Cloud vision
OLLAMA_API_KEY=
THOX_OLLAMA_CLOUD_URL=https://ollama.com
THOX_OLLAMA_CLOUD_MODEL=qwen3-vl:235b-cloud

# QidiStudio / QIDISlicer closed-loop revision engine
THOX_QIDI_SLICER_BIN=qidi-slicer
THOX_QIDI_SLICE_TIMEOUT_S=900
# Optional override for vendor builds whose CLI syntax differs. Placeholders:
# {slicer} {profile} {override} {output} {model}
THOX_QIDI_SLICE_COMMAND=

# Persistent local event/revision history
THOX_PRINT_HEALTH_STATE_DIR=~/.thoxforge/print-health

# Remote THOX Forger access to the unified sidecar. If --allow-remote is used,
# this token is mandatory. Also protect the service with Tailscale ACLs/reverse proxy.
THOX_PRINT_HEALTH_TOKEN=

# Object-scan calibration motion is disabled by default. The AI never receives
# generic raw G-code control; this only enables hard-clamped known scan poses.
THOX_ALLOW_SCAN_MOTION=false
